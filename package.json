{
	"name": "ai-vector-db-per-tenant",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "remix vite:build",
		"dev": "remix vite:dev",
		"db:generate": "drizzle-kit generate --config=./app/lib/db/config.ts",
		"db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate --config=./app/lib/db/config.ts",
		"db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio --config=./app/lib/db/config.ts",
		"format": "bunx biome format --write .",
		"lint": "bunx biome lint --write .",
		"start": "remix-serve ./build/server/index.js",
		"typecheck": "tsc",
		"vector-db-api:generate": "bunx openapi-typescript https://neon.tech/api_spec/release/v2.json -o ./app/lib/vector-db/api-schema.ts",
		"vector-db:generate": "drizzle-kit generate --config=./app/lib/vector-db/config.ts",
		"vector-db:migrate": "tsx --env-file=.env ./migrate.ts",
		"documents:backfill-overviews": "tsx --env-file=.env ./scripts/backfill-overviews.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^0.2.16",
		"@ai-sdk/react": "^1.2.12",
		"@langchain/community": "^0.2.27",
		"@langchain/core": "^0.2.23",
		"@neondatabase/serverless": "^0.9.5",
		"@radix-ui/react-avatar": "^1.1.0",
		"@remix-run/node": "^2.12.0",
		"@remix-run/react": "^2.12.0",
		"@remix-run/serve": "^2.12.0",
		"@tanstack/react-query": "^5.51.23",
		"@uploadthing/react": "^7.3.3",
		"@upstash/ratelimit": "^2.0.1",
		"@upstash/redis": "^1.34.0",
		"ai": "^4.3.19",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"drizzle-orm": "^0.33.0",
		"drizzle-zod": "^0.5.1",
		"isbot": "^4.1.0",
		"lucide-react": "^1.55.0",
		"nanoid": "^5.0.7",
		"openapi-fetch": "^0.11.1",
		"postgres": "^3.4.4",
		"react": "^18.2.0",
		"react-aria-components": "^1.3.1",
		"react-dom": "^18.2.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^2.0.23",
		"remark-gfm": "^4.0.1",
		"remix-auth": "^3.7.0",
		"remix-auth-google": "^2.0.0",
		"remix-utils": "^7.6.0",
		"sonner": "^1.5.0",
		"tailwind-merge": "^2.5.2",
		"unpdf": "^0.11.0",
		"uploadthing": "^7.7.4",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@remix-run/dev": "^2.10.3",
		"@types/react": "^18.2.20",
		"@types/react-dom": "^18.2.7",
		"autoprefixer": "^10.4.19",
		"drizzle-kit": "^0.24.0",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.4",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-react-aria-components": "^1.1.4",
		"tsx": "^4.20.6",
		"typescript": "^5.1.6",
		"vite": "^5.1.0",
		"vite-tsconfig-paths": "^4.2.1"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
